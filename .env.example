# ---- service ----
HOST=0.0.0.0
PORT=8000
# Comma-separated. LEAVE EMPTY ONLY IN DEVELOPMENT — empty disables auth.
API_KEYS=change-me-before-you-expose-this
CORS_ORIGINS=*

# ---- ComfyUI backend ----
COMFY_HOST=127.0.0.1
COMFY_PORT=8188
COMFY_ROOT=/opt/ComfyUI
# true  -> this API spawns and supervises ComfyUI (single-container deploy)
# false -> attach to an instance you started yourself
COMFY_MANAGE=true
# Add --lowvram on cards under ~16GB. Leave empty on L4/L40S/A100 and up.
COMFY_EXTRA_ARGS=
COMFY_BOOT_TIMEOUT=600

# ---- model filenames (must match scripts/download_models.sh) ----
UNET_NAME=flux-2-klein-9b-Q8_0.gguf
CLIP_NAME=qwen_3_8b_fp8mixed.safetensors
VAE_NAME=flux2-vae.safetensors
LORA_NAME=flux-klein-tryon-comfy.safetensors

# ---- generation defaults ----
# Sub-10s preset, measured on an RTX 4090: 5 steps at 0.75 MP -> 9.1-9.7s
# across all ten sample garments, 768x1008 output. 6 steps pushed every one
# of them to ~11s. Resolution costs more than steps, so if you need to trim
# further, drop megapixels before you drop steps.
#
# For catalog assets use 16 steps / 2.0 MP instead (~80s, 1248x1664).
DEFAULT_STEPS=5
DEFAULT_CFG=1.0
DEFAULT_LORA_STRENGTH=0.4
DEFAULT_MEGAPIXELS=0.75

# ---- jobs ----
WORKERS=1
JOB_TTL_SECONDS=3600
